<Project>

  <!--
    Base version for all shippable RoslynMcp packages (Contracts, Core, Cli, Server).
    Bump this single value for a release. With no VersionSuffix the package version is
    exactly this (e.g. 0.5.0). install-local.ps1 sets VersionSuffix=local at pack time,
    so locally-installed dev builds (0.5.0-local) stay distinguishable from released
    packages (0.5.0).
  -->
  <PropertyGroup>
    <VersionPrefix>0.5.0</VersionPrefix>
  </PropertyGroup>

</Project>
